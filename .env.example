# MagnoTrack Environment Variables
# Copy this file to .env for local development

# PostgreSQL Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://magnotrack:magnotrack_secret@db:5432/magnotrack_db

# Web Server Port (Render sets this dynamically via $PORT)
PORT=8000

# CORS Allowed Origins (Comma-separated or * for all)
CORS_ORIGINS=*

# Device Inactivity Timeout in seconds (default 30 seconds)
DEVICE_OFFLINE_THRESHOLD_SECONDS=30
